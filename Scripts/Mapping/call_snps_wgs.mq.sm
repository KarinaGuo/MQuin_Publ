import pandas as pd
configfile: "config.yaml"

samples_table=pd.read_table("meta/sample_table.tsv")
samples_table.set_index('file',inplace=True)
filepair_ID=samples_table.index.unique(level=None)
NSW_numbers = samples_table["sample"].values.tolist()
lane_ID=["L001"]

rg_dict={}
for i in range(len(filepair_ID)):
    nn=NSW_numbers[i]
    irg="r" + "\"@RG\tID:" + nn + "\tSM:" + nn + "\""
    rg_dict[filepair_ID[i]]=NSW_numbers[i]


rule all:
    input:
        expand("raw/{samp}_{lane}_R1_001.fastq.gz",samp=filepair_ID,lane=lane_ID),
        expand("raw/{samp}_{lane}_R2_001.fastq.gz",samp=filepair_ID,lane=lane_ID),
        expand("proc/{samp}_mkdup.bai",samp=filepair_ID),
        "snp/variant_raw.vcf"

rule trim:
    input:
        rp1="raw/{samp}_{lane}_R1_001.fastq.gz",
        rp2="raw/{samp}_{lane}_R2_001.fastq.gz"
    output:
        rp1="trim/{samp}_{lane}_p1.fastq.gz",
        rp2="trim/{samp}_{lane}_p2.fastq.gz",
        rd="trim/{samp}_{lane}_d.fastq.gz",
        st="trim/{samp}_{lane}_st.fastq.gz",
        set="trim/{samp}_{lane}_settings",
        col="trim/{samp}_{lane}_cl.fastq.gz",
        ct="trim/{samp}_{lane}_ct.fastq.gz"
    params:
        adapter1=config['trim_adapt1'],
        adapter2=config['trim_adapt2'],
        minq=config['trim_minq'],
        twin=config['trim_twin'],
        adapterremoval=config['adapterremoval_path'],
        #tms=config['trim_module_statement'],
    threads: config['trim_threads']
    shell:
        """
        {params.adapterremoval} --file1 {input.rp1} --file2 {input.rp2} --output1 {output.rp1} --output2 {output.rp2} --singleton {output.st} --discarded {output.rd} --outputcollapsed {output.col} --outputcollapsedtruncated {output.ct} --settings {output.set} --adapter1 {params.adapter1} --adapter2 {params.adapter2} --trimns --trimqualities --trimwindows {params.twin} --minquality {params.minq} --collapse --threads {threads} --gzip
        """

rule cat_se_fq:
    input:
        st="trim/{samp}_{lane}_st.fastq.gz",
        col="trim/{samp}_{lane}_cl.fastq.gz",
        ct="trim/{samp}_{lane}_ct.fastq.gz"
    output:
        se="trim/{samp}_{lane}_se.fastq.gz"
    shell:
        """
        zcat {input.st} {input.col} {input.ct} | gzip > {output.se}
        """

rule mappe:
    input:
        ref=config['refseq'],
        rp1="trim/{samp}_{lane}_p1.fastq.gz",
        rp2="trim/{samp}_{lane}_p2.fastq.gz"
    output:
        bam="map/{samp}_{lane}_pe.bam"
    threads: config['map_threads']
    log:
        "map/{samp}_{lane}.pe.log"
    params:
        rg=r"@RG\tID:{samp}\tSM:{samp}",
        #rg=lambda wildcards: rg_dict[ wildcards.samp ],
        bwa=config['bwa_path'],
        samtools=config['samtools_path']
    shell:
        """
        {params.bwa} mem -t {threads} -R '{params.rg}' {input.ref} {input.rp1} {input.rp2} | {params.samtools} sort -@ {threads} -o {output.bam} 2> {log}
        """

rule mapse:
    input:
        ref=config['refseq'],
        rse=rules.cat_se_fq.output.se
    output:
        bam="map/{samp}_{lane}_se.bam"
    threads: config['map_threads']
    log:
        "map/{samp}_{lane}.se.log"
    params:
        rg=r"@RG\tID:{samp}\tSM:{samp}",
        #rg=lambda wildcards: rg_dict[ wildcards.samp ],
        bwa=config['bwa_path'],
        samtools=config['samtools_path']
    shell:
        """
        {params.bwa} mem -t {threads} -R '{params.rg}' {input.ref} {input.rse}  | {params.samtools} sort -@ {threads} -o {output.bam} 2> {log}
        """


rule merge_bams:
    input:
        sebam=expand("map/{{samp}}_{lane}_se.bam",lane=lane_ID),
        pebam=expand("map/{{samp}}_{lane}_pe.bam",lane=lane_ID)
    output:
        temp("proc/{samp}_merge.bam")
    threads: config['map_threads']
    log:
        "proc/{samp}.merge.log"
    params:
        samtools=config['samtools_path']
    shell:
         """
         {params.samtools} merge -@ {threads} {output} {input.sebam} {input.pebam} 2> {log}
         """


rule sortn:
    input:
        "proc/{samp}_merge.bam"
    output:
        temp("proc/{samp}_srtn.bam")
    threads: config['map_threads']
    log:
        "proc/{samp}.sortn.log"
    params:
        samtools=config['samtools_path']
    shell:
        """
        {params.samtools} sort -n -@ {threads} -O bam {input} > {output} 2> {log}
        """

rule fixmate:
    input:
        "proc/{samp}_srtn.bam"
    output:
        temp("proc/{samp}_fixmate.bam")
    threads: config['map_threads']
    log:
        "proc/{samp}.fixmate.log"
    params:
        samtools=config['samtools_path']
    shell:
        """
        {params.samtools} fixmate -m -@ {threads} {input} {output} 2> {log}
        """

rule sortc:
    input:
        "proc/{samp}_fixmate.bam"
    output:
        temp("proc/{samp}_srtc.bam")
    threads: config['map_threads']
    log:
        "proc/{samp}.sortc.log"
    params:
        samtools=config['samtools_path']
    shell:
        """
        {params.samtools} sort -@ {threads} -O bam {input} > {output} 2> {log}
        """

rule mkdup:
    input:
        "proc/{samp}_srtc.bam"
    output:
        "proc/{samp}_mkdup.bam"
    threads: config['map_threads']
    log:
        "proc/{samp}.mkdup.log"
    params:
        samtools=config['samtools_path']
    shell:
        """
        {params.samtools} markdup -@ {threads} {input} {output} 2> {log}
        """

rule index_bam:
    input:
        "proc/{samp}_mkdup.bam"
    output:
        "proc/{samp}_mkdup.bai"
    threads: config['map_threads']
    log:
        "proc/{samp}.index.log"
    params:
        samtools=config['samtools_path']
    shell:
        """
        {params.samtools} index -@ {threads} {input} {output} 2> {log}
        """

rule call_snps:
    input:
        bams=expand("proc/{samp}_mkdup.bam", samp=filepair_ID),
        bais=expand("proc/{samp}_mkdup.bai", samp=filepair_ID),
        ref=config['refseq']
#        ,reg=config['regions']
    output:
        "snp/variant_raw.vcf"
    threads: config['snp_threads']
    log:
        "snp/fb.log"
    params:
        freebayes=config['freebayes_path'],
        fb_gen_reg=config['fb_gen_reg_path']
    shell:
        """
        {params.freebayes} <({params.fb_gen_reg} {input.ref}.fai 10000000) {threads} -f {input.ref} {input.bams} > {output} 2> {log}
        """
